              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/orders/99999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "99999"
              ]
