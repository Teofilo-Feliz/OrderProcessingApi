{
  "info": {
    "_postman_id": "c04039a9-e4d1-4083-a49d-537329b70b71",
    "name": "OrderProcessingApi",
    "description": "Colección para probar la API de procesamiento de pedidos con reserva de stock.\n\nAntes de ejecutarla se deben correr los scripts de la carpeta DataBase y tener la API en ejecución. La URL base se configura en la variable base_url de la colección.\n\nLas peticiones de creación guardan el Id generado en las variables productoId y pedidoId para usarlo en las consultas por Id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "52318691"
  },
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "Obtener productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La respuesta es una lista\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Obtiene todos los productos con su Id, Nombre, Precio y Stock. Si no hay productos devuelve una lista vacía."
          },
          "response": []
        },
        {
          "name": "Obtener producto por Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Devuelve el producto solicitado\", function () {",
                  "    pm.expect(pm.response.json().id).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products",
                "1"
              ]
            },
            "description": "Obtiene un producto específico por su Id."
          },
          "response": []
        },
        {
          "name": "Obtener producto inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/99999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products",
                "99999"
              ]
            },
            "description": "Consulta un producto que no existe. Debe responder 404 Not Found."
          },
          "response": []
        },
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Devuelve el Id generado\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.productoId).to.be.above(0);",
                  "    pm.collectionVariables.set(\"productoId\", data.productoId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Impresora HP\",\n    \"precio\": 8500.00,\n    \"stock\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Crea un nuevo producto. El Id lo genera SQL Server y se guarda en la variable productoId."
          },
          "response": []
        },
        {
          "name": "Obtener producto creado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Devuelve el producto creado\", function () {",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"productoId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/{{productoId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products",
                "{{productoId}}"
              ]
            },
            "description": "Consulta el producto creado en la petición anterior."
          },
          "response": []
        },
        {
          "name": "Crear producto con datos inválidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Devuelve los errores de validación\", function () {",
                  "    pm.expect(pm.response.json().errores).to.have.lengthOf(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"\",\n    \"precio\": 0,\n    \"stock\": -1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Intenta crear un producto con nombre vacío, precio en cero y stock negativo. Debe responder 400 Bad Request con los tres errores."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Crear pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Devuelve el Id del pedido\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.pedidoId).to.be.above(0);",
                  "    pm.collectionVariables.set(\"pedidoId\", data.pedidoId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productos\": [\n        { \"productoId\": 1, \"cantidad\": 2 },\n        { \"productoId\": 3, \"cantidad\": 1 }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Crea un pedido con varios productos. El total se calcula con el precio de la base de datos y se descuenta el stock dentro de una transacción. El Id se guarda en la variable pedidoId."
          },
          "response": []
        },
        {
          "name": "Crear pedido con stock insuficiente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Devuelve la lista de productos rechazados\", function () {",
                  "    pm.expect(pm.response.json().errores).to.have.lengthOf.at.least(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productos\": [\n        { \"productoId\": 2, \"cantidad\": 1 },\n        { \"productoId\": 6, \"cantidad\": 999 }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Uno de los productos no tiene stock suficiente. Se hace rollback de la transacción, no se descuenta el stock de ningún producto y se responde 400 Bad Request con los productos rechazados."
          },
          "response": []
        },
        {
          "name": "Crear pedido con producto inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productos\": [\n        { \"productoId\": 99999, \"cantidad\": 1 }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Intenta crear un pedido con un producto que no existe. Debe responder 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "Crear pedido sin productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productos\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Intenta crear un pedido con la lista de productos vacía. Debe responder 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "Obtener pedidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La respuesta es una lista\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Obtiene los pedidos registrados con su Id, FechaPedido, Total y Estado."
          },
          "response": []
        },
        {
          "name": "Obtener pedido por Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Incluye los detalles del pedido\", function () {",
                  "    pm.expect(pm.response.json().productos).to.be.an(\"array\").that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/orders/{{pedidoId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "{{pedidoId}}"
              ]
            },
            "description": "Obtiene el pedido creado con sus productos, cantidad, precio unitario y subtotal."
          },
          "response": []
        },
